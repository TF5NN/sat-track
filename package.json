{
  "name": "tf5nn-sat-track",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.mjs",
    "sync:orbits": "node --import tsx scripts/sync-orbits.ts",
    "validate:data": "node --import tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "satellite.js": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.10.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
